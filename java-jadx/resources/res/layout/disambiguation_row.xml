<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/aap_device_disambiguation_dialog_row"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1"
    android:paddingVertical="@dimen/listItemPaddingVertical">
    <TextView
        android:textAppearance="@style/TextAppearance.ListItem"
        android:id="@+id/aap_device_disambiguation_dialog_row_device_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:paddingHorizontal="@dimen/listItemPaddingHorizontal"/>
    <TextView
        android:textAppearance="@style/TextAppearance.ListItem"
        android:gravity="end"
        android:id="@+id/aap_device_disambiguation_dialog_row_wireless"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:textAlignment="gravity"
        android:paddingHorizontal="@dimen/listItemPaddingHorizontal"/>
</LinearLayout>
