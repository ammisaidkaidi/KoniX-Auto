<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#8a94cbff" />
            <stroke android:width="4.0dip" android:color="#ff94cbff" />
            <size android:height="48.0dip" android:width="48.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#3d94cbff" />
            <stroke android:width="8.0dip" android:color="#ff94cbff" />
            <size android:height="48.0dip" android:width="48.0dip" />
        </shape>
    </item>
    <item>
        <ripple android:color="#27ffffff">
            <item android:id="@android:id/mask">
                <shape android:shape="oval">
                    <solid android:color="#ffffffff" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
